# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Secure-only session/CSRF cookies; defaults to True. Local http needs False.
DJANGO_SECURE_COOKIES=False
# Trusted reverse-proxy hops in front of the app (0 locally; set per deploy).
DJANGO_NUM_PROXIES=0
DATABASE_URL=postgres://reviewflow_app:local_dev_only@localhost:5432/reviewflow
REDIS_URL=redis://localhost:6379/0

# Public API rate limits (Authentication.md §2). Both are DRF sliding-window
# throttle rates, e.g. "600/min".
API_KEY_RATE=600/min
API_KEY_IP_RATE=1200/min

# Required for TOTP 2FA (Phase 02) and, later, Google/Meta OAuth tokens.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Read by later phases; placeholders only.
META_APP_ID=
META_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Provider webhook receivers (Phase 06, spec Decision 15). Per-IP, since
# these are unauthenticated until signature verification.
WEBHOOK_IP_RATE=1200/min

# Cloudflare R2 -- blobs only (CSV imports; QR images in a later phase).
# csv-imports/ needs a bucket lifecycle rule expiring objects after 1 day
# as the backstop to the app's own post-import delete (CSV-Import.md).
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# CSV Import limits (Phase 06, spec Decision 10).
CSV_IMPORT_MAX_BYTES=5242880
CSV_IMPORT_MAX_ROWS=10000

# Shopify app (06-shopify-app, spec Decision 3). Platform secrets --
# never stored per merchant. SHOPIFY_CLIENT_SECRET_PREVIOUS is set only
# during a client-secret rotation (Shopify.md).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_CLIENT_SECRET_PREVIOUS=
SHOPIFY_API_VERSION=
SHOPIFY_REDIRECT_URI=
# The ReviewFlow link page on the dashboard/frontend origin, e.g.
# https://<dashboard-host>/integrations/shopify/link (spec Decision 3,
# "Link page URL").
SHOPIFY_LINK_PAGE_URL=
