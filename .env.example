# Copy to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Secure-only session/CSRF cookies; defaults to True. Local http needs False.
DJANGO_SECURE_COOKIES=False
# Trusted reverse-proxy hops in front of the app (0 locally; set per deploy).
DJANGO_NUM_PROXIES=0
DATABASE_URL=postgres://reviewflow_app:local_dev_only@localhost:5432/reviewflow
REDIS_URL=redis://localhost:6379/0

# Public API rate limits (Authentication.md §2). Both are DRF sliding-window
# throttle rates, e.g. "600/min".
API_KEY_RATE=600/min
API_KEY_IP_RATE=1200/min

# Required for TOTP 2FA (Phase 02) and, later, Google/Meta OAuth tokens.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Read by later phases; placeholders only.
META_APP_ID=
META_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
